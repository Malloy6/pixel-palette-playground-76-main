FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY disable-event-loop-delay-metrics.patch /tmp/disable-event-loop-delay-metrics.patch

RUN git init \
    && git remote add origin https://github.com/jitsi/excalidraw-backend.git \
    && git fetch --depth=1 origin bbeda26743074b8b36b1be9fe09ba07f3a501439 \
    && git checkout --detach FETCH_HEAD \
    && git apply /tmp/disable-event-loop-delay-metrics.patch \
    && npm ci \
    && npm run build \
    && rm /tmp/disable-event-loop-delay-metrics.patch

ENV NODE_ENV=production
ENV PORT=80

EXPOSE 80 9090

CMD ["node", "dist/index.js"]
