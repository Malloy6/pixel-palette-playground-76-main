{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.9.0",
  "scripts": {
    "dev": "scripts/use-project-node.sh vite dev",
    "db:setup:pg": "scripts/use-project-node.sh node scripts/setup-pg.mjs",
    "test:integration": "playwright test",
    "build": "scripts/use-project-node.sh vite build",
    "verify:production-build": "scripts/use-project-node.sh node scripts/verify-production-build.mjs",
    "build:production": "npm run build && npm run verify:production-build",
    "deploy:self-hosted": "npm run build:production && sudo systemctl restart elimusphere",
    "build:dev": "scripts/use-project-node.sh vite build --mode development",
    "preview": "scripts/use-project-node.sh vite preview",
    "deploy:cloudflare": "scripts/use-project-node.sh npx wrangler deploy --env production",
    "deploy:cloudflare:build": "npm run build:production && npm run deploy:cloudflare",
    "start": "scripts/start-prod.sh",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.25.5",
    "@hookform/resolvers": "^5.2.2",
